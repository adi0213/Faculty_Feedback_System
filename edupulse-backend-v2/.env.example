# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development                      # development | production | test
APP_SECRET_KEY=change-me-in-production-must-be-32-chars-min
APP_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://edupulse:edupulse123@localhost:5432/edupulse_v2
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# For production use RS256 with a proper private key:
# JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
# JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem

# ─── LLM ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here
LLM_MODEL=gpt-5.5                   # or ollama/llama3.2 for local
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.3
LLM_ENABLED=true                         # false = mock responses (for testing)

# ─── Anonymization ───────────────────────────────────────────────────────────
HMAC_SECRET=change-me-separate-secret-for-anonymization
K_ANONYMITY_THRESHOLD=8                  # Minimum responses before report generated

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_FEEDBACK_PER_HOUR=10
RATE_LIMIT_AUTH_PER_MINUTE=5
RATE_LIMIT_API_PER_MINUTE=60

# ─── Scoring ─────────────────────────────────────────────────────────────────
SCORING_ALPHA=0.70                       # Weight: objective vs sentiment
SCORING_BAYES_K=8                        # Empirical Bayes prior sample size
SCORING_WINSOR_LOW=5                     # Winsorization lower percentile
SCORING_WINSOR_HIGH=95                   # Winsorization upper percentile
TEMPORAL_CLUSTER_WINDOW_HOURS=24         # Flag if >50% ratings in this window
TEMPORAL_CLUSTER_THRESHOLD=0.5          # Fraction that triggers flag

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json                          # json | pretty (for development)
